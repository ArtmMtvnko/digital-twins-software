{
  // Налаштування для допоміжних скриптів: ті самі правила, що й для src/,
  // але без компіляції в dist/ (скрипти запускаються через tsx).
  // rootDir — корінь проєкту, бо скрипти можуть імпортувати код із src/
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true
  },
  "include": ["."]
}
